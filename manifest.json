{
  "manifest_version": 3,
  "name": "Disney+ Picture-in-Picture Fix",
  "version": "1.0.3",
  "description": "Adds back Picture-in-Picture functionality on Disney+ ALT+P",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://*.disneyplus.com/*"],
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon.png" },
  "background": { "service_worker": "background.js" },
  "commands": {
    "toggle-pip": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Toggle Picture-in-Picture"
    }
  },
  "content_scripts": [
    { "matches": ["https://*.disneyplus.com/*"], "js": ["content.js"] }
  ]
}
